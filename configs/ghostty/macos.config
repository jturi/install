# =============================================================================
# GHOSTTY CONFIG (macOS) — installed to
#   ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty
# =============================================================================
#
# RELOAD / EDIT THIS FILE
#   cmd+shift+,          Reload config (applies changes without restarting)
#   cmd+,                Open config in your editor (Ghostty default)
#   After editing in the repo: make configs, then reload as above.
#   List every active binding: ghostty +list-keybinds
#
# TMUX INTEGRATION
#   Cmd+1..9 send Alt+1..9 and Cmd+l / Cmd+j send Alt+l / Alt+j (below), so
#   tmux bindings bind -n M-<n>, M-l, M-j switch windows. Prefix is Ctrl+a.
#   Alt+<key> typed directly also reaches tmux (Ghostty sends Alt as Meta).
#
# CUSTOM MAPPINGS (below)
#   cmd+1 .. cmd+9       -> Alt+1 .. Alt+9  (tmux jump to window N)
#                           Overrides Ghostty's default "goto tab N".
#   cmd+l / cmd+j        -> Alt+l / Alt+j   (tmux next / previous window)
#
# COMMON GHOSTTY DEFAULTS (macOS)
#   cmd+t / cmd+w        New tab / close tab
#   cmd+n                New window
#   cmd+d                Split right
#   cmd+shift+d          Split down
#   cmd+[ / cmd+]        Previous / next split
#   cmd+alt+arrows       Move focus between splits
#   cmd+shift+enter      Zoom current split (toggle)
#   cmd+k                Clear screen
#   cmd+f                Search scrollback
#   cmd+c / cmd+v        Copy / paste
#   cmd+= / cmd+-        Increase / decrease font size
#   cmd+0                Reset font size
#
# Full default list: https://ghostty.org/docs/config/keybind
# =============================================================================

# Cmd+1..9 -> send Alt+1..9 (ESC + digit) so tmux's `bind -n M-<n>` switches windows.
# Overrides Ghostty's default Cmd+<n> = goto_tab.
keybind = super+digit_1=esc:1
keybind = super+digit_2=esc:2
keybind = super+digit_3=esc:3
keybind = super+digit_4=esc:4
keybind = super+digit_5=esc:5
keybind = super+digit_6=esc:6
keybind = super+digit_7=esc:7
keybind = super+digit_8=esc:8
keybind = super+digit_9=esc:9

# Cmd+l / Cmd+j -> send Alt+l / Alt+j so tmux's `bind -rn M-l` / `M-j` switch windows.
keybind = super+l=esc:l
keybind = super+j=esc:j
