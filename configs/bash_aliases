# ~/.bash_aliases (from the install repo) — sourced by bash and zsh.
# Put your own aliases here or in ~/.bash_aliases2.

# listing
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# navigation
alias ..='cd ..'
alias ...='cd ../..'

# safety: ask before overwriting
alias cp='cp -i'
alias mv='mv -i'

# colors
alias grep='grep --color=auto'

# tmux
alias ta='tmux attach || tmux new'
alias tl='tmux ls'

# tm [session]: attach-or-create (default tmux1); inside tmux, switch client instead of nesting.
tm() {
  command -v tmux >/dev/null 2>&1 || { echo "tm: tmux is not installed" >&2; return 127; }
  local s="${1:-tmux1}"
  if [[ -n ${TMUX:-} ]]; then
    TERM=xterm-256color tmux new-session -Ad -s "$s" && tmux switch-client -t "$s"
  else
    TERM=xterm-256color tmux new-session -A -s "$s"
  fi
}
