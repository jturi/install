# --- sudo/processes  ---
alias sudo2='sudo ' # trailing space: next word gets alias-expanded too
# again: rerun the previous command as root (fc is POSIX; works in bash+zsh,
# unlike !! inside aliases which only bash expands). `fc -ln -1` prints the
# line with leading blanks; eval splits it into words the way the shell did.
# It runs exactly what you typed last, so it is shown first.
again() {
  local c
  c="$(fc -ln -1)"
  c="${c#"${c%%[![:space:]]*}"}"
  [ -n "$c" ] || { echo "again: no previous command" >&2; return 1; }
  printf 'sudo %s\n' "$c" >&2
  eval "sudo $c"
}
# psg <pat>: find processes (pgrep ships on both via procps / macOS base).
psg() {
  [ $# -ge 1 ] || { echo "usage: psg <pattern>" >&2; return 1; }
  pgrep -af -- "$*"
}
# Top RAM/CPU consumers via POSIX sort -n -k (dotfiles use GNU-only --sort).
alias psmem='ps aux | sort -nrk 4 | head -n 15'
alias pscpu='ps aux | sort -nrk 3 | head -n 15'
# killport <port>: kill whatever LISTENS on TCP <port>. Not clients that
# merely talk to it: `lsof -i tcp:443` would include your browser. lsof
# works on both (`ss -tlnp` is Linux-only).
killport() {
  [ $# -eq 1 ] || { echo "usage: killport <port>" >&2; return 1; }
  case "$1" in ''|*[!0-9]*) echo "killport: not a port: $1" >&2; return 1 ;; esac
  local pids
  pids="$(lsof -nP -t -iTCP:"$1" -sTCP:LISTEN 2>/dev/null)"
  [ -n "$pids" ] || { echo "killport: nothing listens on TCP $1" >&2; return 1; }
  # xargs splits the PID list the same way in bash and zsh (zsh does not
  # word-split an unquoted $pids).
  printf '%s\n' "$pids" | xargs kill
}
# ports: listening TCP sockets (`lsof` ships on both via setup/brew).
alias ports='lsof -i -P -n | grep LISTEN'

# df -h: identical flags on both. duh: size of each entry, smallest first.
# Sorted on kilobytes, then printed human-readable: GNU `du --max-depth`
# and `sort -h` do not exist on macOS, and `sort -n` misorders "2.0M" < "600K".
alias dfh='df -h'
duh() {
  if [ -n "${ZSH_VERSION:-}" ]; then setopt localoptions null_glob; else shopt -s nullglob; fi
  du -sk -- * .[!.]* 2>/dev/null | sort -n | awk -F'\t' '{
    s = $1; u = "K"
    if (s >= 1048576) { s /= 1048576; u = "G" } else if (s >= 1024) { s /= 1024; u = "M" }
    printf "%6.1f%s\t%s\n", s, u, $2 }'
  if [ -z "${ZSH_VERSION:-}" ]; then shopt -u nullglob; fi
}

# --- network/download ---
# myip: public IP (curl ships on both; matches dotfiles myip).
alias myip='curl -fsS --max-time 5 https://ipinfo.io/ip; echo'
# down <url> [file]: curl, wget fallback (same shape as dotfiles down()).
down() {
  if [ $# -eq 0 ]; then echo "Usage: down <url> [filename]" >&2; return 1; fi
  if command -v curl >/dev/null 2>&1; then
    curl -fL --progress-bar -o "${2:-$(basename "$1")}" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --show-progress -O "${2:-$(basename "$1")}" "$1"
  else
    echo "down: neither curl nor wget found" >&2; return 1
  fi
}
# serve [port]: loopback-only static server from stdlib python3.
serve() { python3 -m http.server "${1:-8000}" --bind 127.0.0.1; }
alias ping5='ping -c 5' # -c works on both (avoid -W: syntax differs)

# --- files/archives ---
alias md='mkdir -p'
# extract <file>: tar/zip only (no python; mirrors dotfiles extract.sh core).
extract() {
  [ $# -eq 1 ] || { echo "usage: extract <archive>" >&2; return 1; }
  case "$1" in
    *.tar.gz|*.tgz) tar xzf "$1" ;;
    *.tar.bz2|*.tbz2) tar xjf "$1" ;;
    *.tar.xz|*.txz) tar xJf "$1" ;;
    *.tar) tar xf "$1" ;;
    *.zip) unzip -q "$1" ;;
    *) echo "extract: unknown format: $1" >&2; return 1 ;;
  esac
}

# --- search ---
# hgrep <pat>: grep shell history.
hgrep() { history | grep -i -- "$@"; }
# alg <pat>: grep loaded aliases + matching function names.
# `alias` prints name=value lines, so `alg psmem` shows its line.
# Colors only when stdout is a terminal (not piped or redirected) and
# NO_COLOR is unset (https://no-color.org).
alg() {
  [ $# -ge 1 ] || { echo "usage: alg <pattern>" >&2; return 1; }
  local color=never
  if [ -t 1 ] && [ -z "${NO_COLOR-}" ]; then color=always; fi
  alias | grep -i --color="${color}" -- "$*" || true
  declare -F | awk '{print $NF}' | grep -i --color="${color}" -- "$*" || true
}
